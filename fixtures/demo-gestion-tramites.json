   "content": {
    "classDiagramArtifactId": "cd",
    "description": {
     "useCaseNumber": "3",
     "useCaseName": "Registrar cambio de estado de trámite",
     "actor": "Consultor",
     "description": "El consultor actualiza el estado de los trámites que tiene asignados.",
     "priority": "A",
     "inputParameters": "VcodConsultor, VnroTramite, acción (Confirmar-Rechazar)",
     "precondition": "El consultor inició sesión en el sistema.",
     "postcondition": "El trámite queda en el nuevo estado.",
     "initialState": "Instancia de Consultor con:\n• fechaHoraBajaConsultor igual a vacío",
     "finalState": "Si confirma...\nInstancia de EstadoTramite creada con:\n• fechaDesde igual a fecha actual"
    },
    "basicFlow": [
     {
      "id": "b1",
      "actor": "El consultor selecciona la opción Cambiar estado de trámite.",
      "system": "",
      "ref": ""
     },
     {
      "id": "b2",
      "actor": "",
      "system": "El sistema busca los trámites con estado actual vigente y los muestra.",
      "ref": ""
     },
     {
      "id": "b3",
      "actor": "El consultor selecciona un trámite y el nuevo estado.",
      "system": "",
      "ref": "A1"
     },
     {
      "id": "b4",
      "actor": "",
      "system": "El sistema registra el cambio y cierra el estado anterior.",
      "ref": ""
     }
    ],
    "alternativeFlows": [
     {
      "id": "alt1",
      "code": "A1",
      "name": "No hay trámites para el consultor",
      "steps": [
       {
        "id": "x1",
        "actor": "",
        "system": "El sistema informa que no hay trámites y finaliza el caso de uso.",
        "ref": ""
       }
      ]
     }
    ]
